# Copy this file to .env.dev (at repo root, next to scripts/) and fill in real
# values. .env.dev is git-ignored and never committed.
#
# Used by scripts/deploy-dev-local.sh to bootstrap Kubernetes Secrets in the
# weather-bridge-dev namespace on the first deploy. After the first deploy the
# secrets persist in-cluster; to rotate, delete the secret and re-run the script.

# --- app-secret (weather-bridge-dev/app-secret) ---
APP_DATABASE_URL=postgresql+asyncpg://vai:DEV_PG_PASSWORD@db:5432/weather_bridge
APP_KEYCLOAK_AUDIENCE=weather-bridge-fe
APP_LITELLM_API_KEY=
APP_LITELLM_MASTER_KEY=
APP_OPENAI_API_KEY=
APP_LANGFUSE_PUBLIC_KEY=
APP_LANGFUSE_SECRET_KEY=
APP_WEB_PUSH_SUBJECT=mailto:dev@weatherbridge.local
APP_WEB_PUSH_VAPID_PRIVATE_KEY=
APP_WEB_PUSH_VAPID_PUBLIC_KEY=

# --- db-secret (weather-bridge-dev/db-secret) ---
DB_POSTGRES_USER=vai
DB_POSTGRES_PASSWORD=DEV_PG_PASSWORD
DB_POSTGRES_DB=weather_bridge

# --- keycloak-secret (weather-bridge-dev/keycloak-secret) ---
KC_DB_PASSWORD=DEV_KC_DB_PASSWORD
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=DEV_KC_ADMIN_PASSWORD

# --- GHCR pull (only if --source ghcr and packages are private) ---
# GHCR_USER=
# GHCR_PAT=

# --- optional live Hmong translation (never committed) ---
# Put vertex-key.json at the repository root. It is git-ignored and the deploy
# script automatically creates/rotates weather-bridge-dev/vertex-credentials
# from it. Set this only when the key is stored somewhere else.
# VERTEX_CREDENTIALS_FILE=/path/to/vertex-key.json

# --- override the GitHub owner used to form GHCR image refs (auto-detected
#     from git remote if not set) ---
# OWNER_LOW=anhtrinh2905
