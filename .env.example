APP_ENV=development
APP_NAME=Weather Bridge AI
DATABASE_URL=postgresql+asyncpg://vai:vai@localhost:5432/weather_bridge
REDIS_URL=redis://localhost:6379/0
POSTGRES_HOST_PORT=5432
# App database credentials (consumed by compose.yaml via ${VAR:-default} interpolation).
# Defaults are non-production local dev values; override in .env for anything shared.
POSTGRES_USER=vai
POSTGRES_PASSWORD=vai
POSTGRES_DB=weather_bridge
# Keycloak's own database credentials (separate postgres instance).
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=
KEYCLOAK_REALM=weather-bridge
KEYCLOAK_CLIENT_ID=weather-bridge-fe
KEYCLOAK_ISSUER=http://localhost:8080/realms/weather-bridge
KEYCLOAK_AUDIENCE=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
CORS_ORIGINS=http://localhost:5173
# Web Push / VAPID. Leave keys blank for local demo; the API will generate
# ephemeral raw base64url VAPID keys at startup, so subscriptions must be
# re-enabled after restart. For persistent dev/prod keys, store raw base64url
# private key and uncompressed public key.
WEB_PUSH_SUBJECT=mailto:dev@weatherbridge.local
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
# Open-Meteo forecast API (worker ingest, Story 2.2). No API key required.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
LITELLM_ENABLED=false
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=
LITELLM_MODEL=mock-model
LITELLM_MASTER_KEY=local-dev-key-change-me
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
VITE_API_BASE_URL=/api/v1
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=weather-bridge
VITE_KEYCLOAK_CLIENT_ID=weather-bridge-fe
