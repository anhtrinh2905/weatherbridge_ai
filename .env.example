APP_ENV=development
APP_NAME=Weather Bridge AI
DATABASE_URL=postgresql+asyncpg://vai:vai@localhost:5432/weather_bridge
REDIS_URL=redis://localhost:6379/0
POSTGRES_HOST_PORT=5432
POSTGRES_USER=vai
POSTGRES_PASSWORD=vai
POSTGRES_DB=weather_bridge
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=
KEYCLOAK_REALM=weather-bridge
KEYCLOAK_CLIENT_ID=weather-bridge-fe
KEYCLOAK_ISSUER=http://localhost:8080/realms/weather-bridge
KEYCLOAK_AUDIENCE=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
CORS_ORIGINS=http://localhost:5173
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_API_KEY=
OPEN_METEO_TIMEOUT_SECONDS=15
OPEN_METEO_RETRY_ATTEMPTS=3
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_ENSEMBLE_URL=https://ensemble-api.open-meteo.com/v1/ensemble
OPEN_METEO_HISTORICAL_WEATHER_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_PREVIOUS_RUNS_URL=https://previous-runs-api.open-meteo.com/v1/forecast
OPEN_METEO_HISTORICAL_FORECAST_URL=https://historical-forecast-api.open-meteo.com/v1/forecast
OPEN_METEO_FLOOD_URL=https://flood-api.open-meteo.com/v1/flood
LITELLM_ENABLED=false
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=
LITELLM_MODEL=mock-model
LITELLM_MASTER_KEY=local-dev-key-change-me
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
# Machine translation may only create drafts; reviewed Vietnamese remains the runtime fallback.
GOOGLE_TRANSLATE_CREDENTIALS_PATH=
# Optional local MMS TTS model for Hmong audio. Requires backend image/runtime to include
# transformers, torch, and scipy; otherwise /api/v1/speech/mms returns 503 clearly.
MMS_TTS_REPO_ID=facebook/mms-tts
MMS_TTS_HMONG_SUBFOLDER=models/hmn
VERTEX_LOCATION=us-central1
VERTEX_GEMINI_MODEL=gemini-2.5-flash
PII_MODE=simulated
PII_ENCRYPTION_KEY=
PII_HASH_KEY=
PII_KEY_VERSION=v1
OBJECT_STORAGE_BASE_URL=
OBJECT_STORAGE_SIGNING_KEY=
OBJECT_STORAGE_URL_TTL_SECONDS=300
NOTIFICATION_DELIVERY_MODE=disabled
# Persistent VAPID keys are required before enabling live Web Push delivery.
WEB_PUSH_SUBJECT=mailto:dev@weatherbridge.local
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
# Set NOTIFICATION_DELIVERY_MODE=configured to enable one or more configured
# worker-only providers. Twilio sends SMS to E.164 contact values; Zalo OA sends
# customer-service messages to the OA user ID stored as the zalo contact value.
SMS_PROVIDER=disabled
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=
SMS_TWILIO_MESSAGING_SERVICE_SID=
ZALO_PROVIDER=disabled
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_API_BASE_URL=https://openapi.zalo.me
VITE_ENABLE_MACHINE_TRANSLATIONS=false
VITE_API_BASE_URL=/api/v1
VITE_HAZARD_SOURCE=mock
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=weather-bridge
VITE_KEYCLOAK_CLIENT_ID=weather-bridge-fe
