[Unit]
Description=Weather Bridge pull deployment (%i)
After=network-online.target docker.service k3s.service
Wants=network-online.target
Requires=k3s.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/weatherbridge/common.env
EnvironmentFile=/etc/weatherbridge/%i.env
ExecStart=/usr/local/libexec/weatherbridge/pull-deploy %i
TimeoutStartSec=15min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=multi-user.target
